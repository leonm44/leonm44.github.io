---
interface Props {
  values: number[];
  width?: number;
  height?: number;
}
const { values, width = 280, height = 64 } = Astro.props;
const min = Math.min(...values);
const max = Math.max(...values);
const x = (i: number) => (i / (values.length - 1)) * width;
const y = (v: number) => height - 4 - ((v - min) / (max - min || 1)) * (height - 8);
const line = values.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const area = `${line} L${width},${height} L0,${height} Z`;
const up = values.at(-1)! >= values[0];
const color = up ? 'var(--up)' : 'var(--down)';
const id = `sg${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" class="spark" role="img" aria-label="One-year price trend">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={color} stop-opacity="0.28"></stop>
      <stop offset="1" stop-color={color} stop-opacity="0"></stop>
    </linearGradient>
  </defs>
  <path d={area} fill={`url(#${id})`}></path>
  <path d={line} fill="none" stroke={color} stroke-width="1.6" vector-effect="non-scaling-stroke"></path>
</svg>

<style>
  .spark { width: 100%; height: 64px; display: block; }
</style>

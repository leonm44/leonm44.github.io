---
import Base from '../layouts/Base.astro';
import EtfDetail from './EtfDetail.astro';
import market from '../data/market.json';
import { ETFS, SLEEVES } from '../data/etfs.mjs';

interface Props {
  sleeve: 'core' | 'satellite';
  description: string;
}
const { sleeve, description } = Astro.props;
const etfs = ETFS.filter((e) => e.sleeve === sleeve);
const m = market.etfs as Record<string, any>;
---

<Base title={`${SLEEVES[sleeve].title} ETFs`} description={description}>
  <section class="intro">
    <div class="wrap">
      <div class="eyebrow">{SLEEVES[sleeve].title} sleeve</div>
      <h1>{SLEEVES[sleeve].tagline}</h1>
      <slot name="intro" />
      <nav class="jump" aria-label="On this page">
        {etfs.map((e) => <a class="pill" href={`#${e.id}`}>{e.short}</a>)}
      </nav>
    </div>
  </section>
  {
    etfs.map((e) => (
      <section class="section">
        <div class="wrap">
          <EtfDetail etf={e} m={m[e.id]} />
        </div>
      </section>
    ))
  }
  <slot />
</Base>

<style>
  .intro { padding: 64px 0 40px; }
  .intro h1 { font-size: clamp(2rem, 4.4vw, 3rem); max-width: 22ch; }
  .jump { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 22px; }
  .jump a:hover { color: var(--text); text-decoration: none; border-color: var(--accent); }
</style>

---
// Dotted world map: click a region (or a button) to select one of the three
// core ETFs and see the countries it covers. Dots come from
// src/data/world-dots.json (generated by scripts/make-world-dots.mjs).
import world from '../data/world-dots.json';
import { byId } from '../data/etfs.mjs';
import { pct, tone, url } from '../lib/format';

interface Props {
  metrics: Record<string, any>;
}
const { metrics } = Astro.props;

const W = 720;
const H = Math.round((W * (world.latMax - world.latMin + world.step)) / 360);
const px = (lon: number) => ((lon + 180) / 360) * W;
const py = (lat: number) => ((world.latMax - lat) / (world.latMax - world.latMin + world.step)) * H + 3;
const r = ((world.step / 360) * W) * 0.34;

const OPTIONS = [
  { id: 'msci-world', countries: 23, cover: 'US, Canada, 16 European & Middle-East markets, Japan, Australia, New Zealand, Hong Kong, Singapore' },
  { id: 'sp500', countries: 1, cover: 'United States only, about two-thirds of the MSCI World by itself' },
  { id: 'stoxx-600', countries: 17, cover: 'Western Europe plus Poland, inside and outside the eurozone, incl. the UK and Switzerland' },
];
const info = OPTIONS.map((o) => ({ ...o, etf: byId[o.id], m: metrics[o.id] }));
---

<div class="wm panel" data-sel="msci-world">
  <svg viewBox={`0 0 ${W} ${H}`} class="map" role="group" aria-label="World map of the countries covered by each core ETF">
    {
      world.dots.map((d) => {
        const cls = [d.w && 'w', d.s && 's', d.x && 'x'].filter(Boolean).join(' ');
        return <circle cx={px(d.lon).toFixed(1)} cy={py(d.lat).toFixed(1)} r={r.toFixed(2)} class={cls || undefined} />;
      })
    }
  </svg>

  <div class="side">
    <div class="eyebrow">Where does the money go?</div>
    <div class="choices" role="radiogroup" aria-label="Core ETF">
      {
        info.map((o, i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-id={o.id} id={`wm-${o.id}`}>
            {o.etf.short}
          </button>
        ))
      }
    </div>
    <div class="details">
    {
      info.map((o, i) => (
        <div class="detail" data-for={o.id} aria-hidden={i !== 0 ? 'true' : 'false'}>
          <p class="cover">
            <b class="mono">{o.countries} {o.countries > 1 ? 'countries' : 'country'}</b> · {o.cover}.
          </p>
          <p class="line mono">
            {o.etf.ticker} · 1Y <span class={tone(o.m.perf.y1)}>{pct(o.m.perf.y1)}</span> · {o.m.trend}
          </p>
          <a href={url(`/core#${o.id}`)}>Open the {o.etf.short} chart →</a>
        </div>
      ))
    }
    </div>
    <p class="hint faint">Click a region on the map or a name above.</p>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.wm')) {
    const select = (id: string) => {
      root.dataset.sel = id;
      root.querySelectorAll<HTMLButtonElement>('.choices button').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.id === id)));
      root.querySelectorAll<HTMLElement>('.detail').forEach((d) => d.setAttribute('aria-hidden', String(d.dataset.for !== id)));
      document.querySelectorAll<HTMLElement>('[data-etf]').forEach((c) => c.classList.toggle('is-selected', c.dataset.etf === id));
    };
    root.querySelectorAll<HTMLButtonElement>('.choices button').forEach((b) => b.addEventListener('click', () => select(b.dataset.id!)));
    const regionOf = (el: Element) =>
      el.classList.contains('s') ? 'sp500' : el.classList.contains('x') ? 'stoxx-600' : el.classList.contains('w') ? 'msci-world' : null;
    const svg = root.querySelector('svg')!;
    svg.addEventListener('click', (e) => {
      const id = regionOf(e.target as Element);
      if (id) select(id);
    });
    svg.addEventListener('pointerover', (e) => {
      root.dataset.hover = regionOf(e.target as Element) ?? '';
    });
    svg.addEventListener('pointerleave', () => (root.dataset.hover = ''));
    select(root.dataset.sel!);
  }
</script>

<style>
  .wm { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 24px; align-items: center; margin-bottom: 18px; padding: 18px 22px; }
  .map { width: 100%; height: auto; display: block; }
  circle { fill: var(--line); transition: fill 0.25s, opacity 0.25s; }
  circle.w, circle.s, circle.x { fill: #3a4160; cursor: pointer; }

  /* hover preview */
  .wm[data-hover='msci-world'] circle.w,
  .wm[data-hover='sp500'] circle.s,
  .wm[data-hover='stoxx-600'] circle.x { fill: #6b5aa8; }

  /* selection */
  .wm[data-sel='msci-world'] circle.w,
  .wm[data-sel='sp500'] circle.s,
  .wm[data-sel='stoxx-600'] circle.x { fill: var(--accent); }
  .wm[data-sel='sp500'] circle.s { fill: var(--accent-2); }
  .wm[data-sel='stoxx-600'] circle.x { fill: #60a5fa; }

  .side { min-width: 0; }
  .choices { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .choices button {
    font: 600 0.85rem var(--sans); color: var(--muted); background: transparent;
    border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; cursor: pointer;
  }
  .choices button:hover { color: var(--text); border-color: var(--faint); }
  .choices button[aria-checked='true'] { color: #140b1f; background: var(--grad); border-color: transparent; }
  .choices button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* All three descriptions share one grid cell: the box always has the height of
     the longest one, so switching ETF never moves the rest of the page. */
  .details { display: grid; }
  .detail { grid-area: 1 / 1; }
  .detail[aria-hidden='true'] { visibility: hidden; }
  .detail p { margin: 0 0 8px; font-size: 0.92rem; }
  .cover { color: var(--muted); }
  .cover b { color: var(--text); }
  .line { font-size: 0.85rem !important; }
  .detail a { font-size: 0.9rem; }
  .hint { font-size: 0.78rem; margin: 12px 0 0; }
  @media (max-width: 820px) { .wm { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { circle { transition: none; } }

  /* highlight of the matching card elsewhere on the page */
  :global([data-etf].is-selected) { border-color: rgba(167, 139, 250, 0.75); box-shadow: 0 0 0 1px rgba(167, 139, 250, 0.35), 0 10px 30px -12px rgba(167, 139, 250, 0.45); }
</style>

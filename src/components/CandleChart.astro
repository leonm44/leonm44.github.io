---
// Server-rendered SVG candlestick chart: no charting library, every pixel is
// computed here from the pipeline output. Optional RSI and MACD panels.
interface Bar {
  d: string; o: number; h: number; l: number; c: number;
  s20: number | null; s50: number | null; s200: number | null;
  rsi: number | null; macd: number | null; sig: number | null; hist: number | null;
}
interface Props {
  bars: Bar[];
  indicators?: boolean;
  label: string;
}
const { bars, indicators = true, label } = Astro.props;

const W = 1000;
const PL = 6;
const PR = 62;
const plotW = W - PL - PR;
const P = { top: 12, bottom: 300 };
const R = { top: 330, bottom: 410 };
const M = { top: 440, bottom: 520 };
const H = indicators ? 548 : 328;
const axisY = indicators ? 538 : 318;

const n = bars.length;
const step = plotW / n;
const bw = Math.max(1.5, step * 0.62);
const cx = (i: number) => PL + step * (i + 0.5);

const lows = bars.map((b) => b.l);
const highs = bars.map((b) => b.h);
const smaVals = bars.flatMap((b) => [b.s20, b.s50, b.s200]).filter((v): v is number => v !== null);
let pMin = Math.min(...lows, ...smaVals);
let pMax = Math.max(...highs, ...smaVals);
const pad = (pMax - pMin) * 0.06;
pMin -= pad;
pMax += pad;
const py = (v: number) => P.bottom - ((v - pMin) / (pMax - pMin)) * (P.bottom - P.top);

function niceTicks(min: number, max: number, count = 5) {
  const raw = (max - min) / count;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const stepT = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= raw)!;
  const ticks = [];
  for (let t = Math.ceil(min / stepT) * stepT; t <= max; t += stepT) ticks.push(+t.toFixed(6));
  return ticks;
}
const priceTicks = niceTicks(pMin, pMax);
const decimals = pMax < 50 ? 2 : pMax < 500 ? 1 : 0;

const linePath = (key: 's20' | 's50' | 's200', yf: (v: number) => number) =>
  bars
    .map((b, i) => (b[key] === null ? null : `${cx(i).toFixed(1)},${yf(b[key] as number).toFixed(1)}`))
    .reduce((acc, pt) => {
      if (pt === null) return acc + ' ';
      return acc + (acc.endsWith(' ') || acc === '' ? 'M' : 'L') + pt;
    }, '')
    .trim();

// Month labels on the x axis.
const months: { i: number; label: string }[] = [];
bars.forEach((b, i) => {
  if (i === 0 || b.d.slice(5, 7) !== bars[i - 1].d.slice(5, 7)) {
    const dt = new Date(`${b.d}T12:00:00Z`);
    months.push({ i, label: dt.toLocaleDateString('en-GB', { month: 'short', ...(b.d.slice(5, 7) === '01' || i === 0 ? { year: '2-digit' } : {}) }) });
  }
});

// RSI panel
const ry = (v: number) => R.bottom - (v / 100) * (R.bottom - R.top);
const rsiPath = bars
  .map((b, i) => (b.rsi === null ? null : `${cx(i).toFixed(1)},${ry(b.rsi).toFixed(1)}`))
  .filter(Boolean)
  .map((p, k) => (k ? 'L' : 'M') + p)
  .join('');

// MACD panel
const macdVals = bars.flatMap((b) => [b.macd, b.sig, b.hist]).filter((v): v is number => v !== null);
const mAbs = Math.max(...macdVals.map(Math.abs), 1e-9) * 1.1;
const my = (v: number) => (M.top + M.bottom) / 2 - (v / mAbs) * ((M.bottom - M.top) / 2);
const series = (key: 'macd' | 'sig') =>
  bars
    .map((b, i) => (b[key] === null ? null : `${cx(i).toFixed(1)},${my(b[key] as number).toFixed(1)}`))
    .filter(Boolean)
    .map((p, k) => (k ? 'L' : 'M') + p)
    .join('');

const readoutData = JSON.stringify(bars.map((b) => [b.d, b.o, b.h, b.l, b.c, b.rsi, b.hist]));
const last = bars.at(-1)!;
---

<figure class="chart" data-bars={readoutData} data-pl={PL} data-step={step} data-w={W}>
  <div class="legend">
    <span class="readout" aria-live="polite">
      <b>{last.d}</b> O {last.o} H {last.h} L {last.l} C {last.c}
    </span>
    <span class="keys">
      <i style="--c: var(--sma20)">SMA 20</i><i style="--c: var(--sma50)">SMA 50</i><i style="--c: var(--sma200)">SMA 200</i>
    </span>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Daily candlestick chart of ${label}, last ${n} sessions`}>
    <!-- price grid -->
    {
      priceTicks.map((t) => (
        <g>
          <line x1={PL} x2={W - PR} y1={py(t)} y2={py(t)} class="grid" />
          <text x={W - PR + 6} y={py(t) + 4} class="tick">{t.toFixed(decimals)}</text>
        </g>
      ))
    }
    {months.map((m) => <line x1={cx(m.i) - step / 2} x2={cx(m.i) - step / 2} y1={P.top} y2={indicators ? M.bottom : P.bottom} class="grid v" />)}

    <!-- candles -->
    {
      bars.map((b, i) => {
        const up = b.c >= b.o;
        const top = py(Math.max(b.o, b.c));
        const bodyH = Math.max(1, Math.abs(py(b.o) - py(b.c)));
        return (
          <g class={up ? 'c-up' : 'c-down'}>
            <line x1={cx(i)} x2={cx(i)} y1={py(b.h)} y2={py(b.l)} />
            <rect x={cx(i) - bw / 2} y={top} width={bw} height={bodyH} rx="0.6" />
          </g>
        );
      })
    }

    <!-- moving averages -->
    <path d={linePath('s200', py)} class="ma" style="stroke: var(--sma200)" />
    <path d={linePath('s50', py)} class="ma" style="stroke: var(--sma50)" />
    <path d={linePath('s20', py)} class="ma" style="stroke: var(--sma20)" />
    <line x1={PL} x2={W - PR} y1={py(last.c)} y2={py(last.c)} class="last-line" />
    <rect x={W - PR + 2} y={py(last.c) - 9} width={PR - 4} height="18" rx="4" class="last-tag" />
    <text x={W - PR + 6} y={py(last.c) + 4} class="tick last">{last.c.toFixed(decimals)}</text>

    {
      indicators && (
        <g>
          <text x={PL + 4} y={R.top - 6} class="panel-label">RSI (14)</text>
          <rect x={PL} y={ry(70)} width={plotW} height={ry(30) - ry(70)} class="rsi-band" />
          {[30, 50, 70].map((t) => (
            <g>
              <line x1={PL} x2={W - PR} y1={ry(t)} y2={ry(t)} class={t === 50 ? 'grid' : 'grid dash'} />
              <text x={W - PR + 6} y={ry(t) + 4} class="tick">{t}</text>
            </g>
          ))}
          <path d={rsiPath} class="rsi" />

          <text x={PL + 4} y={M.top - 6} class="panel-label">MACD (12, 26, 9)</text>
          <line x1={PL} x2={W - PR} y1={my(0)} y2={my(0)} class="grid" />
          {bars.map((b, i) =>
            b.hist === null ? null : (
              <rect
                x={cx(i) - bw / 2}
                width={bw}
                y={Math.min(my(0), my(b.hist))}
                height={Math.max(0.5, Math.abs(my(b.hist) - my(0)))}
                class={b.hist >= 0 ? 'h-up' : 'h-down'}
              />
            ),
          )}
          <path d={series('macd')} class="macd" />
          <path d={series('sig')} class="sig" />
        </g>
      )
    }

    {months.map((m) => <text x={cx(m.i) - step / 2 + 4} y={axisY} class="tick">{m.label}</text>)}
    <line class="cursor" x1="0" x2="0" y1={P.top} y2={indicators ? M.bottom : P.bottom} visibility="hidden" />
  </svg>
  {
    indicators && (
      <figcaption class="faint">
        Top: daily candles with 20, 50 and 200-session simple moving averages. Middle: RSI, shaded zone between 30 and
        70. Bottom: MACD line (blue), signal line (orange), histogram = their difference.
      </figcaption>
    )
  }
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('figure.chart')) {
    const bars = JSON.parse(fig.dataset.bars!);
    const pl = +fig.dataset.pl!;
    const step = +fig.dataset.step!;
    const w = +fig.dataset.w!;
    const svg = fig.querySelector('svg')!;
    const cursor = svg.querySelector<SVGLineElement>('.cursor')!;
    const out = fig.querySelector('.readout')!;
    const fmt = (v: number | null) => (v === null ? '—' : String(v));
    const show = (i: number) => {
      const [d, o, h, l, c, r, hist] = bars[i];
      const chg = i > 0 ? (c / bars[i - 1][4] - 1) * 100 : 0;
      out.innerHTML = `<b>${d}</b> O ${o} H ${h} L ${l} C ${c} <span class="${chg >= 0 ? 'up' : 'down'}">${chg >= 0 ? '+' : ''}${chg.toFixed(2)}%</span> · RSI ${fmt(r)} · MACD hist ${fmt(hist)}`;
    };
    svg.addEventListener('pointermove', (e) => {
      const rect = svg.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * w;
      const i = Math.min(bars.length - 1, Math.max(0, Math.floor((x - pl) / step)));
      const cx = pl + step * (i + 0.5);
      cursor.setAttribute('x1', String(cx));
      cursor.setAttribute('x2', String(cx));
      cursor.setAttribute('visibility', 'visible');
      show(i);
    });
    svg.addEventListener('pointerleave', () => {
      cursor.setAttribute('visibility', 'hidden');
      show(bars.length - 1);
    });
  }
</script>

<style>
  .chart { margin: 0; }
  svg { width: 100%; height: auto; display: block; touch-action: pan-y; }
  .legend { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 0.82rem; margin-bottom: 8px; }
  .readout { font-family: var(--mono); color: var(--muted); }
  .readout :global(b) { color: var(--text); font-weight: 600; }
  .keys { display: flex; gap: 14px; }
  .keys i { font-style: normal; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
  .keys i::before { content: ''; width: 14px; height: 2px; background: var(--c); border-radius: 2px; }
  figcaption { font-size: 0.82rem; margin-top: 8px; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .grid.v { stroke-opacity: 0.45; }
  .grid.dash { stroke-dasharray: 3 4; }
  .tick { fill: var(--faint); font: 11px var(--mono); }
  .tick.last { fill: #0b0d14; font-weight: 600; }
  .last-tag { fill: var(--accent); }
  .last-line { stroke: var(--accent); stroke-dasharray: 2 3; stroke-opacity: 0.7; }
  .c-up line, .c-up rect { stroke: var(--up); fill: var(--up); }
  .c-down line, .c-down rect { stroke: var(--down); fill: var(--down); }
  .c-up rect { fill-opacity: 0.85; }
  .ma { fill: none; stroke-width: 1.6; }
  .panel-label { fill: var(--muted); font: 600 11px var(--mono); }
  .rsi-band { fill: var(--accent); fill-opacity: 0.07; }
  .rsi { fill: none; stroke: var(--accent); stroke-width: 1.6; }
  .macd { fill: none; stroke: var(--sma50); stroke-width: 1.5; }
  .sig { fill: none; stroke: #fb923c; stroke-width: 1.5; }
  .h-up { fill: var(--up); fill-opacity: 0.45; }
  .h-down { fill: var(--down); fill-opacity: 0.45; }
  .cursor { stroke: var(--text); stroke-opacity: 0.35; stroke-dasharray: 3 3; }
</style>

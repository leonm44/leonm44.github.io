---
import '../styles/global.css';
import market from '../data/market.json';
import { url, longDate } from '../lib/format';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fullTitle = title === 'Home' ? 'Leon Market Compass' : `${title} · Leon Market Compass`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Dashboard' },
  { href: '/core', label: 'Core' },
  { href: '/satellite', label: 'Satellite' },
  { href: '/candlesticks', label: 'Candlesticks 101' },
  { href: '/methodology', label: 'Methodology' },
];
const asOf = Object.values(market.etfs)[0]?.asOf;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    {
      market.sample && (
        <div class="sample-banner">
          Preview build with <strong>simulated</strong> prices. The live site is rebuilt every trading day with real market data.
        </div>
      )
    }
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={url('/')}>
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
            <defs>
              <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#a78bfa" /><stop offset="1" stop-color="#f472b6" />
              </linearGradient>
            </defs>
            <circle cx="16" cy="16" r="14" fill="none" stroke="url(#lg)" stroke-width="2.5"></circle>
            <path d="M16 6 L19.5 16 L16 26 L12.5 16 Z" fill="url(#lg)"></path>
          </svg>
          <span>Leon <b>Market Compass</b></span>
        </a>
        <nav aria-label="Main">
          {
            nav.map((n) => (
              <a href={url(n.href)} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap foot">
        <p>
          <strong>Not investment advice.</strong> This site is an educational project. It shows past prices and mechanical
          indicators; none of it is a recommendation to buy or sell anything. Past performance does not predict future
          returns.
        </p>
        <p class="faint">
          Data: {market.source}{asOf && ` · last session ${longDate(asOf)}`} · Built with Astro, deployed on GitHub
          Pages.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .sample-banner {
    background: repeating-linear-gradient(135deg, #3b2a0b 0 12px, #33250a 12px 24px);
    color: #fcd34d; text-align: center; font-size: 0.88rem; padding: 8px 16px;
    border-bottom: 1px solid #5c4410;
  }
  .top {
    position: sticky; top: 0; z-index: 10;
    backdrop-filter: blur(12px); background: rgba(11, 13, 20, 0.72);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text); font-weight: 500; }
  .brand b { font-weight: 800; }
  .brand:hover { text-decoration: none; }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a { color: var(--muted); padding: 7px 12px; border-radius: 8px; font-size: 0.93rem; }
  nav a:hover { color: var(--text); background: var(--panel); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--text); background: var(--panel-2); }
  footer { border-top: 1px solid var(--line); margin-top: 40px; padding: 36px 0 48px; font-size: 0.9rem; color: var(--muted); }
  .foot p { max-width: 80ch; }
  @media (max-width: 720px) {
    .bar { padding: 10px 0; }
    nav { overflow-x: auto; flex-wrap: nowrap; width: 100%; padding-bottom: 4px; }
  }
</style>

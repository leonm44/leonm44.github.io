---
import Base from '../layouts/Base.astro';
import CandleGlyph from '../components/CandleGlyph.astro';
import CandleChart from '../components/CandleChart.astro';
import market from '../data/market.json';
import { ETFS } from '../data/etfs.mjs';
import { url } from '../lib/format';

const m = market.etfs as Record<string, any>;
const example = ETFS[0];
const recent = m[example.id].chart.slice(-40);

const patterns = [
  {
    id: 'doji',
    name: 'Doji',
    candles: [{ o: 40, h: 62, l: 22, c: 50, ghost: true }, { o: 52, h: 70, l: 34, c: 52.5 }],
    what: 'Open and close almost equal: a tiny body, wicks on both sides.',
    means: 'Buyers and sellers ended the day in a draw. After a long move, it signals hesitation, not a reversal on its own.',
  },
  {
    id: 'hammer',
    name: 'Hammer',
    candles: [{ o: 70, h: 72, l: 55, c: 58, ghost: true }, { o: 56, h: 60, l: 46, c: 50, ghost: true }, { o: 40, h: 46, l: 10, c: 45 }],
    what: 'Small body at the top, long lower wick at least twice the body, after a decline.',
    means: 'Sellers pushed the price down during the day, buyers brought it back up. A possible sign that the fall is running out of steam.',
  },
  {
    id: 'shooting-star',
    name: 'Shooting star',
    candles: [{ o: 30, h: 42, l: 28, c: 40, ghost: true }, { o: 42, h: 55, l: 40, c: 52, ghost: true }, { o: 56, h: 92, l: 54, c: 58 }],
    what: 'The mirror image: small body at the bottom, long upper wick, after a rise.',
    means: 'Buyers tried to push higher but sellers took over before the close. A warning after an advance.',
  },
  {
    id: 'bullish-engulfing',
    name: 'Bullish engulfing',
    candles: [{ o: 70, h: 72, l: 50, c: 55, ghost: true }, { o: 58, h: 60, l: 40, c: 44 }, { o: 40, h: 68, l: 38, c: 64 }],
    what: 'A green body that completely covers the previous red body.',
    means: 'Buyers took full control from one day to the next. More meaningful after a decline and with higher volume.',
  },
  {
    id: 'bearish-engulfing',
    name: 'Bearish engulfing',
    candles: [{ o: 30, h: 50, l: 28, c: 45, ghost: true }, { o: 44, h: 62, l: 42, c: 58 }, { o: 62, h: 64, l: 34, c: 38 }],
    what: 'A red body that completely covers the previous green body.',
    means: 'Sellers took over in a single session. More meaningful after a rise.',
  },
  {
    id: 'marubozu',
    name: 'Marubozu (strong candle)',
    candles: [{ o: 20, h: 82, l: 19, c: 81 }, { o: 80, h: 81, l: 18, c: 19 }],
    what: 'A long body with almost no wicks, green or red.',
    means: 'One side dominated from the open to the close. It shows conviction, often at the start or in the middle of a move.',
  },
];
---

<Base title="Candlesticks 101" description="How to read a Japanese candlestick: open, high, low, close, and six classic patterns explained simply.">
  <section class="intro">
    <div class="wrap">
      <div class="eyebrow">Candlesticks 101</div>
      <h1>One candle = one day of <span class="gradient-text">trading, in four prices.</span></h1>
      <p class="lead">
        Candlestick charts come from 18th-century Japanese rice traders. They pack four numbers into a single shape, so
        you can see at a glance who won the day: buyers or sellers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap anatomy">
      <div class="panel figure">
        <svg viewBox="0 0 460 300" role="img" aria-label="Anatomy of a bullish and a bearish candle">
          <g class="u">
            <line x1="120" x2="120" y1="30" y2="270" /><rect x="90" y="80" width="60" height="140" rx="4" />
          </g>
          <g class="d">
            <line x1="330" x2="330" y1="30" y2="270" /><rect x="300" y="80" width="60" height="140" rx="4" />
          </g>
          <g class="lbl">
            <text x="120" y="20" text-anchor="middle">High</text>
            <text x="120" y="292" text-anchor="middle">Low</text>
            <text x="160" y="84">Close</text>
            <text x="160" y="224">Open</text>
            <text x="20" y="155">Body</text>
            <text x="330" y="20" text-anchor="middle">High</text>
            <text x="330" y="292" text-anchor="middle">Low</text>
            <text x="370" y="84">Open</text>
            <text x="370" y="224">Close</text>
            <text x="138" y="55" class="small">upper wick</text>
            <text x="348" y="250" class="small">lower wick</text>
          </g>
        </svg>
        <div class="caps">
          <span class="up">Bullish: close above open</span>
          <span class="down">Bearish: close below open</span>
        </div>
      </div>
      <div>
        <h2>The four prices</h2>
        <dl class="defs">
          <div><dt>Open</dt><dd>The first traded price of the day.</dd></div>
          <div><dt>Close</dt><dd>The last price of the day, the one most people quote.</dd></div>
          <div><dt>High / Low</dt><dd>The extremes reached during the day, drawn as thin lines called wicks or shadows.</dd></div>
          <div><dt>Body</dt><dd>The box between open and close. Green (or hollow) when the price rose during the day, red when it fell.</dd></div>
        </dl>
        <p class="muted">
          A long body means a decisive day. Long wicks mean the price travelled far but was pushed back: a sign of a
          fight between buyers and sellers. On this site, one candle is one trading day on Euronext Paris (9:00 to 17:30).
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="eyebrow">Six classic patterns</div>
      <h2>Shapes worth recognising</h2>
      <p class="muted lead">Faded candles show the context; the bright one is the pattern itself.</p>
      <div class="grid grid-3">
        {
          patterns.map((p) => (
            <div class="panel pat" id={p.id}>
              <CandleGlyph candles={p.candles} label={`Illustration of a ${p.name}`} />
              <h3>{p.name}</h3>
              <p><strong>What it looks like.</strong> {p.what}</p>
              <p class="muted"><strong>What it may mean.</strong> {p.means}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="eyebrow">Real data</div>
      <h2>The last 40 sessions of the {example.short}</h2>
      <p class="muted lead">
        Move your cursor over the chart to read each candle's open, high, low and close. Try spotting the long wicks
        and the strong bodies.
      </p>
      <div class="panel"><CandleChart bars={recent} indicators={false} label={example.short} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div class="panel">
        <h3>Context beats shape</h3>
        <p class="muted">
          A hammer in the middle of nowhere means little. Patterns matter more at the end of a clear trend, near a
          previous high or low, and when volume confirms them. On their own, they are weak predictors.
        </p>
      </div>
      <div class="panel">
        <h3>Go further</h3>
        <p class="muted">
          Candles show what happened; indicators like moving averages, RSI and MACD summarise the trend and momentum
          behind them. See how they are computed in <a href={url('/methodology')}>Methodology</a>, or look at them live
          on the <a href={url('/core')}>Core</a> page.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding: 64px 0 40px; }
  .intro h1 { font-size: clamp(2rem, 4.4vw, 3rem); max-width: 22ch; }
  .anatomy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: center; }
  .figure svg { width: 100%; height: auto; }
  .u line, .u rect { stroke: var(--up); fill: var(--up); stroke-width: 3; }
  .d line, .d rect { stroke: var(--down); fill: var(--down); stroke-width: 3; }
  .lbl text { fill: var(--text); font: 600 14px var(--sans); }
  .lbl text.small { fill: var(--muted); font-weight: 400; font-size: 12px; }
  .caps { display: flex; justify-content: space-around; font-size: 0.88rem; margin-top: 8px; gap: 12px; flex-wrap: wrap; }
  .defs { margin: 0 0 16px; display: grid; gap: 10px; }
  .defs dt { font-weight: 700; }
  .defs dd { margin: 0; color: var(--muted); }
  .pat { scroll-margin-top: 90px; }
  .pat p { font-size: 0.93rem; }
  .pat:target { border-color: var(--accent); }
  @media (max-width: 820px) { .anatomy { grid-template-columns: 1fr; } }
</style>
